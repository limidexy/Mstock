# Mstock 本地环境变量示例
# 当前默认不联网，不下载行情数据。

MSTOCK_ENV=local
MSTOCK_LOG_LEVEL=INFO
MSTOCK_ENABLE_NETWORK=false
MSTOCK_DATA_DIR=data

# 以下为可选数据源变量，不填入真实密钥。
STOOQ_API_KEY=
# 需要代理时由用户在当前终端设置，不将凭据提交到仓库。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# 注意：现有联网脚本并未统一读取 MSTOCK_ENABLE_NETWORK。
# 离线运行应使用文档中的离线入口或同时指定跳过联网和跳过下载。
